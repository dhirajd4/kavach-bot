# Copy to .env and fill in. Never commit .env.

# --- Meta WhatsApp Cloud API (developers.facebook.com → your app → WhatsApp → API Setup)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
META_APP_SECRET=
# Any random string; paste the same value in the Meta webhook config.
WHATSAPP_VERIFY_TOKEN=
GRAPH_API_VERSION=v23.0

# --- Privacy: HMAC key used to pseudonymise WhatsApp IDs. Generate: python3 -c "import secrets;print(secrets.token_hex(32))"
USER_HASH_KEY=

# --- Infra (defaults match docker-compose)
DATABASE_URL=postgresql+asyncpg://kavach:kavach@postgres:5432/kavach
REDIS_URL=redis://redis:6379/0

# --- Cloudflare named tunnel token (optional; without it a quick tunnel with a random URL is used)
CLOUDFLARE_TUNNEL_TOKEN=

# --- Bot behaviour
RATE_LIMIT_PER_HOUR=20
REPLY_CACHE_TTL_SECONDS=21600
OPENPHISH_FEED_URL=https://openphish.com/feed.txt
OPENPHISH_SYNC_SECONDS=3600
LOG_LEVEL=INFO
